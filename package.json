{
  "name": "s-nadlan-restored",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build:icons": "node scripts/build-icons.mjs",
    "build": "npm run build:icons && vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/prerender.mjs",
    "build:production": "SITE_INDEX=true npm run build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "media": "node scripts/build-media.mjs",
    "test": "node tests/site.mjs",
    "test:seo": "node tests/seo.mjs",
    "test:a11y": "node tests/accessibility-behavior.mjs && node tests/accessibility-audit.mjs"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.51.0",
    "ffmpeg-static": "^5.3.0",
    "sharp": "^0.35.5",
    "vite": "^6.1.0"
  }
}
